{
  "gitignore": true,
  "globs": [
    "**/*.md",
    "!examples/reports/**/*.md"
  ],
  "config": {
    // Don't enforce maximum line length.
    "MD013": false,
    // Don't enforce ordered list item prefixes.
    "MD029": false,
    // Allow emphasis to be used instead of headings.
    "MD036": false
  }
}
